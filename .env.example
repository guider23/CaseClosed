# ── Copy to .env and fill with real credentials ──

# Razorpay test-mode credentials (dashboard.razorpay.com -> Settings -> API Keys)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
# Webhook signing secret (Settings -> Webhooks). Used for HMAC verification.
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Ngrok webhook URL
NGROK_EXPOSE_URL=your-subdomain.ngrok-free.app/webhooks/razorpay

# LLM for evidence composition. provider: anthropic | openai | gemini
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.6-flash
LLM_API_KEY=your_llm_api_key
LLM_TIMEOUT_SECONDS=30

# Database - Postgres connection string
DATABASE_URL=postgresql://user:password@host:5432/database

# Economics
FP_COST_INR=2000.0

# App
HOST=0.0.0.0
PORT=8000
